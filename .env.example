# ATLAS V1 Environment Variables
# Copy this file to .env and fill in your values.
#
# Important:
# - scripts/validate_local.py and scripts/backfill_5year.py call load_dotenv()
# - the `atlas` CLI and dashboard do NOT load .env automatically
#   (export vars or `source .env` before running those commands)

# ======================
# REQUIRED
# ======================

# Tiingo API Key (get from https://www.tiingo.com/)
TIINGO_API_KEY=your_tiingo_api_key_here

# FRED API Key (get from https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Database Connection String
# For local SQLite:
ATLAS_DB_CONNECTION=sqlite:///atlas_dev.db
# For Azure SQL:
# ATLAS_DB_CONNECTION=mssql+pyodbc://user:password@server.database.windows.net/atlasdb?driver=ODBC+Driver+18+for+SQL+Server

# ======================
# OPTIONAL
# ======================

# Environment overlay for the Python app:
# Selects config/environments/{ATLAS_ENV}.yaml
# Use "development" or "production" here. deploy.sh separately uses
# ATLAS_ENV=dev|staging|prod as a Bicep environment name (default "dev").
# There is no config/environments/dev.yaml — reset this after Azure deploys.
ATLAS_ENV=development

# Azure Key Vault URL (for production secrets management)
# ATLAS_KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# Dashboard users (JSON: username -> sha256 hex of password)
# Default password "atlas123" hash:
# c55c523cd7beebd238b6ea09888a3090961e048bec6de3a24e2aa37432103f59
# If unset or invalid JSON, dashboard falls back to admin/analyst:atlas123
# ATLAS_DASHBOARD_USERS={"admin":"c55c523cd7beebd238b6ea09888a3090961e048bec6de3a24e2aa37432103f59"}

# ======================
# DOCUMENTATION ONLY
# ======================
# The following appear in ops docs / future config but are not read as env vars
# by application code today. Logging and alert settings come from YAML config,
# and no email sender is implemented yet.
# ATLAS_LOG_LEVEL=INFO
# ATLAS_ALERT_EMAILS=team@example.com
#
# deploy.sh only (not read by the Python app):
# ATLAS_RESOURCE_GROUP=atlas-rg
# ATLAS_LOCATION=eastus
