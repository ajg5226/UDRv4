# ATLAS V1 Environment Variables
# Copy this file to .env and fill in your values

# ======================
# REQUIRED
# ======================

# Tiingo API Key (get from https://www.tiingo.com/)
TIINGO_API_KEY=your_tiingo_api_key_here

# FRED API Key (get from https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Database Connection String
# For local SQLite:
ATLAS_DB_CONNECTION=sqlite:///atlas_dev.db
# For Azure SQL:
# ATLAS_DB_CONNECTION=mssql+pyodbc://user:password@server.database.windows.net/atlasdb?driver=ODBC+Driver+18+for+SQL+Server

# ======================
# OPTIONAL
# ======================

# Environment (development, staging, production)
ATLAS_ENV=development

# Azure Key Vault URL (for production secrets management)
# ATLAS_KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# Dashboard users (JSON format for simple auth)
# Format: {"username": "password_sha256_hash"}
# Example ("atlas123" SHA-256):
# ATLAS_DASHBOARD_USERS={"admin":"c55c523cd7beebd238b6ea09888a3090961e048bec6de3a24e2aa37432103f59"}

# Local development only (INSECURE): enables built-in admin/analyst users with password atlas123
# Never enable this in shared or production environments.
# ATLAS_ALLOW_INSECURE_DASHBOARD_DEFAULTS=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
# ATLAS_LOG_LEVEL=INFO

# Alert email recipients (comma-separated)
# ATLAS_ALERT_EMAILS=team@example.com
